# Retal Residence: static site for Apache hosting.

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest

ErrorDocument 404 /404.html

<Files "apple-icon">
  ForceType image/png
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The home page opens in Arabic for Arabic browsers, English for everyone else.
  RewriteCond %{HTTP:Accept-Language} ^ar [NC]
  RewriteRule ^$ /ar/ [L,R=302]
  RewriteRule ^$ /en/ [L,R=302]

  # Pages live in folders: /en/residences -> /en/residences/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Hashed build files and images never change: cache for a year.
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages: always check for a new version.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
